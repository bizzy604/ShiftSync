{
  "name": "shiftsync",
  "private": true,
  "version": "1.0.0",
  "description": "ShiftSync monorepo",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "db:upgrade": "python scripts/alembic_migrate.py upgrade",
    "db:downgrade": "python scripts/alembic_migrate.py downgrade",
    "db:stamp": "python scripts/alembic_migrate.py stamp",
    "db:revision": "python scripts/alembic_migrate.py revision",
    "prisma:deploy": "python scripts/alembic_migrate.py upgrade"
  },
  "dependencies": {
    "docx": "^9.6.0"
  }
}
