APP_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiftsync"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shiftsync"
# Supabase example:
# DATABASE_URL="postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# REDIS_URL="redis://red-<render-redis-id>:6379"
REDIS_URL="redis://localhost:6379/0"

JWT_SECRET="change-me-in-production"
JWT_ALGORITHM="HS256"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=480
TOKEN_COOKIE_NAME="shiftsync_token"

FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,https://shift-sync-web.vercel.app"
CORS_ALLOWED_ORIGINS=""
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# For local development:
# 1) copy this file to .env
# 2) run `npm install` for prisma cli
# 3) run `python -m venv .venv` and install apps/api/requirements.txt
