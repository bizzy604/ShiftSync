generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  manager
  staff

  @@map("role")
}

enum NotificationPreference {
  in_app
  in_app_email

  @@map("notification_preference")
}

enum AvailabilityType {
  recurring
  exception

  @@map("availability_type")
}

enum ShiftStatus {
  draft
  published
  cancelled

  @@map("shift_status")
}

enum AssignmentStatus {
  assigned
  swap_pending
  dropped
  removed

  @@map("assignment_status")
}

enum SwapRequestType {
  swap
  drop

  @@map("swap_request_type")
}

enum SwapRequestStatus {
  OPEN
  PENDING_ACCEPTEE
  PENDING_MANAGER
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED

  @@map("swap_request_status")
}

model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  name                         String                      @db.VarChar(255)
  email                        String                      @unique @db.VarChar(255)
  password_hash                String                      @db.VarChar(255)
  role                         Role
  home_timezone                String                      @default("America/New_York") @db.VarChar(100)
  desired_hours_per_week       Int                         @default(40)
  hourly_rate                  Decimal?                    @db.Decimal(8, 2)
  notification_pref            NotificationPreference      @default(in_app)
  is_active                    Boolean                     @default(true)
  created_at                   DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                    @updatedAt @db.Timestamptz(6)
  user_skills                  UserSkill[]
  user_location_certifications UserLocationCertification[] @relation("UserCertifications")
  manager_location_assignments ManagerLocationAssignment[]
  availability                 Availability[]
  revoked_certs                UserLocationCertification[] @relation("RevokedBy")
  created_shifts               Shift[]                     @relation("ShiftCreatedBy")
  user_assignments             ShiftAssignment[]           @relation("AssignmentUser")
  assignments_made             ShiftAssignment[]           @relation("AssignmentBy")
  swap_requests_initiated      SwapRequest[]               @relation("SwapInitiatedBy")
  swap_requests_targeted       SwapRequest[]               @relation("SwapTargetUser")
  swap_requests_pickup         SwapRequest[]               @relation("SwapPickupUser")
  swap_requests_resolved       SwapRequest[]               @relation("SwapResolvedBy")
  notifications                Notification[]

  @@map("users")
  @@index([role], map: "idx_users_role")
  @@index([is_active], map: "idx_users_active")
}

model Location {
  id                           String                      @id @default(uuid()) @db.Uuid
  name                         String                      @db.VarChar(255)
  address                      String?
  iana_timezone                String                      @db.VarChar(100)
  is_active                    Boolean                     @default(true)
  created_at                   DateTime                    @default(now()) @db.Timestamptz(6)
  user_location_certifications UserLocationCertification[]
  manager_location_assignments ManagerLocationAssignment[]
  shifts                        Shift[]

  @@map("locations")
}

model Skill {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(100)
  user_skills UserSkill[]
  shifts      Shift[]     @relation("RequiredSkill")

  @@map("skills")
}

model UserSkill {
  user_id  String @db.Uuid
  skill_id String @db.Uuid
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([user_id, skill_id])
  @@map("user_skills")
  @@index([skill_id], map: "idx_user_skills_skill")
}

model UserLocationCertification {
  user_id      String    @db.Uuid
  location_id  String    @db.Uuid
  certified_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  revoked_by   String?   @db.Uuid
  user         User      @relation("UserCertifications", fields: [user_id], references: [id], onDelete: Cascade)
  location     Location  @relation(fields: [location_id], references: [id], onDelete: Cascade)
  revoked_user User?     @relation("RevokedBy", fields: [revoked_by], references: [id])

  @@id([user_id, location_id])
  @@map("user_location_certifications")
  @@index([location_id], map: "idx_cert_by_location")
}

model ManagerLocationAssignment {
  manager_id  String   @db.Uuid
  location_id String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  manager     User     @relation(fields: [manager_id], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@id([manager_id, location_id])
  @@map("manager_location_assignments")
  @@index([manager_id], map: "idx_manager_locations")
}

model Availability {
  id            String           @id @default(uuid()) @db.Uuid
  user_id       String           @db.Uuid
  avail_type    AvailabilityType
  day_of_week   Int?
  specific_date DateTime?        @db.Date
  start_clock   String?          @db.VarChar(5)
  end_clock     String?          @db.VarChar(5)
  is_available  Boolean          @default(true)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @updatedAt @db.Timestamptz(6)
  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("availability")
  @@index([user_id, avail_type], map: "idx_avail_user_type")
  @@index([user_id, specific_date], map: "idx_avail_exception")
}

model Shift {
  id                String          @id @default(uuid()) @db.Uuid
  location_id       String          @db.Uuid
  required_skill_id String          @db.Uuid
  shift_date        DateTime        @db.Date
  start_utc         DateTime        @db.Timestamptz(6)
  end_utc           DateTime        @db.Timestamptz(6)
  headcount_needed  Int             @default(1)
  status            ShiftStatus     @default(draft)
  week_start        DateTime        @db.Date
  published_at      DateTime?       @db.Timestamptz(6)
  edit_cutoff_utc   DateTime?       @db.Timestamptz(6)
  created_by        String?         @db.Uuid
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt @db.Timestamptz(6)
  location          Location        @relation(fields: [location_id], references: [id])
  required_skill    Skill           @relation("RequiredSkill", fields: [required_skill_id], references: [id])
  created_by_user   User?           @relation("ShiftCreatedBy", fields: [created_by], references: [id])
  assignments       ShiftAssignment[]

  @@map("shifts")
  @@index([location_id, week_start], map: "idx_shifts_location_week")
  @@index([location_id, shift_date], map: "idx_shifts_location_date")
  @@index([start_utc], map: "idx_shifts_start_utc")
  @@index([status], map: "idx_shifts_status")
}

model ShiftAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  shift_id        String           @db.Uuid
  user_id         String           @db.Uuid
  status          AssignmentStatus @default(assigned)
  version         Int              @default(1)
  assigned_by     String           @db.Uuid
  override_reason String?
  assigned_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  shift           Shift            @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  user            User             @relation("AssignmentUser", fields: [user_id], references: [id])
  assigned_by_user User            @relation("AssignmentBy", fields: [assigned_by], references: [id])
  swap_requests   SwapRequest[]    @relation("RequesterAssignment")
  candidate_swap_requests SwapRequest[] @relation("CandidateAssignment")

  @@unique([shift_id, user_id], map: "shift_assignments_shift_id_user_id_key")
  @@map("shift_assignments")
  @@index([user_id], map: "idx_assignments_user")
  @@index([shift_id], map: "idx_assignments_shift")
}

model SwapRequest {
  id                     String            @id @default(uuid()) @db.Uuid
  type                   SwapRequestType
  requester_assignment_id String           @db.Uuid
  target_user_id         String?           @db.Uuid
  candidate_assignment_id String?          @db.Uuid
  pickup_user_id         String?           @db.Uuid
  status                 SwapRequestStatus @default(PENDING_ACCEPTEE)
  initiated_by           String            @db.Uuid
  expires_at             DateTime?         @db.Timestamptz(6)
  resolved_at            DateTime?         @db.Timestamptz(6)
  resolved_by            String?           @db.Uuid
  resolution_note        String?
  version                Int               @default(1)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime          @updatedAt @db.Timestamptz(6)
  requester_assignment   ShiftAssignment   @relation("RequesterAssignment", fields: [requester_assignment_id], references: [id], onDelete: Cascade)
  candidate_assignment   ShiftAssignment?  @relation("CandidateAssignment", fields: [candidate_assignment_id], references: [id], onDelete: Cascade)
  target_user            User?             @relation("SwapTargetUser", fields: [target_user_id], references: [id])
  pickup_user            User?             @relation("SwapPickupUser", fields: [pickup_user_id], references: [id])
  initiator              User              @relation("SwapInitiatedBy", fields: [initiated_by], references: [id])
  resolver               User?             @relation("SwapResolvedBy", fields: [resolved_by], references: [id])

  @@map("swap_requests")
  @@index([status], map: "idx_swap_status")
  @@index([target_user_id], map: "idx_swap_target")
  @@index([expires_at], map: "idx_swap_expires")
  @@index([initiated_by], map: "idx_swap_initiated_by")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(60)
  message    String
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  read_at    DateTime? @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([user_id, created_at], map: "idx_notif_user_created")
  @@index([user_id, read_at], map: "idx_notif_unread")
}
